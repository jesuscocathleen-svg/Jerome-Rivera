# COLORS AND DESIGN
R = "\033[0m"
B = "\033[1m"
BLUE = "\033[94m"
CYAN = "\033[96m"
GREEN = "\033[92m"
YELLOW = "\033[93m"
RED = "\033[91m"
PURPLE = "\033[95m"


def line():
    print(CYAN + "=" * 60 + R)


def title(text):
    line()
    print(B + PURPLE + text.center(60) + R)
    line()


def pause():
    input(YELLOW + "\nPress ENTER to continue..." + R)


def choose(prompt, options):
    while True:
        answer = input(prompt).strip().upper()
        if answer in options:
            return answer
        print(RED + "Invalid choice. Try again!" + R)


def get_number(prompt):
    while True:
        try:
            return float(input(prompt))
        except ValueError:
            print(RED + "Please enter a valid number!" + R)


